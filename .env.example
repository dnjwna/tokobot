# ============================================================================
# TokoBot - contoh konfigurasi. Salin ke .env lalu isi. JANGAN commit file .env.
#   cp .env.example .env && chmod 600 .env
# ============================================================================

# --- Mode: BACKTEST | PAPER | LIVE -----------------------------------------
TRADING_MODE=PAPER
# Wajib persis frasa ini agar mode LIVE mau jalan (pengaman uang riil)
LIVE_CONFIRM=

# --- Kredensial API Tokocrypto (buat API key KHUSUS bot: Trade ON, Withdraw OFF,
#     whitelist IP VPS). Kosongkan untuk BACKTEST/PAPER.
TOKO_API_KEY=
TOKO_API_SECRET=

# --- Endpoint (default sesuai apidocs; ubah hanya bila Tokocrypto mengubahnya)
TOKO_REST_BASE=https://www.tokocrypto.com
TOKO_MARKET_BASE_TYPE1=https://www.tokocrypto.site
TOKO_MARKET_BASE_TYPE3=https://cloudme-toko.2meta.app
TOKO_WS_MARKET_TYPE1=wss://stream-cloud.tokocrypto.site
TOKO_WS_MARKET_TYPE3=wss://stream-toko.2meta.app
TOKO_WS_API_URL=wss://ws-api.tokocrypto.site:443/ws-api/v3
TOKO_RECV_WINDOW_MS=5000
TOKO_REQUEST_TIMEOUT_S=10
# Dokumentasi tidak menyebut angka limit; nilai konservatif. Bot juga membaca
# header X-MBX-USED-WEIGHT-* dan menghormati Retry-After (429/418).
TOKO_WEIGHT_LIMIT_PER_MIN=600
TOKO_MAX_RETRIES=5

# --- Pasar ------------------------------------------------------------------
SYMBOLS=BTC_USDT,ETH_USDT
QUOTE_ASSET=USDT
TIMEFRAME=4h
HISTORY_BARS=1000

# --- Biaya (fraksi, 0.001 = 0.1%) --------------------------------------------
# Cek fee aktual akun: python scripts/preflight.py --private
# (akun VIP0 yang diverifikasi nov 2026 = 0.15%)
FEE_MAKER=0.0015
FEE_TAKER=0.0015
# PPh 22 final 0.21% (PMK 50/2025, exchange dalam negeri). Default dikenakan di
# dua sisi (konservatif). Verifikasi taxRate di riwayat trade akun Anda.
TAX_RATE_BUY=0.0021
TAX_RATE_SELL=0.0021
SLIPPAGE_PCT=0.0005

# --- Strategi: Volatility Breakout + Regime Filter --------------------------
DONCHIAN_ENTRY=20
EMA_FAST=50
EMA_SLOW=200
EMA_SLOPE_LOOKBACK=10
ADX_PERIOD=14
ADX_MIN=22
ADX_STRONG=30
ADX_RISING_LOOKBACK=3
ATR_PERIOD=14
ATR_PCT_MIN=0.004
ATR_PCT_MAX=0.06
ER_PERIOD=20
ER_MIN=0.30
CLOSE_POSITION_MIN=0.60
VOLUME_SMA_PERIOD=20
VOLUME_MULT=1.0
SL_ATR_MULT=3.0
TP1_R_MULTIPLE=1.5
TP1_FRACTION=0.5
TRAIL_ATR_MULT=3.0
MIN_REWARD_COST_RATIO=3.0
# Biaya round-trip dibagi jarak stop (fraksi). 0.25 = biaya maks 25% dari 1R.
# Contoh: biaya 0.72% -> stop minimal 2.88% dari entry. Naikkan ke ~0.5 untuk perilaku lama.
MAX_COST_TO_RISK=0.25

# --- Risiko & Kill-Switch -----------------------------------------------------
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=2
MAX_POSITION_PCT=0.30
DAILY_MAX_DRAWDOWN=0.03
MAX_TOTAL_DRAWDOWN=0.15
MAX_CONSECUTIVE_LOSSES=4
LOSS_STREAK_PAUSE_HOURS=24
KILL_SWITCH_FLATTEN=false
DAY_RESET_TZ=Asia/Jakarta
USE_EXCHANGE_STOP=true
STOP_LIMIT_BUFFER=0.005
TRAIL_MIN_STEP_PCT=0.002
MAX_ENTRY_SLIPPAGE=0.003
# >0 = bot hanya memakai maksimal sekian USDT sebagai ekuitas (0 = seluruh saldo)
CAPITAL_CAP_QUOTE=0

# --- Runtime -----------------------------------------------------------------
STATE_DIR=state
LOG_DIR=logs
LOG_LEVEL=INFO
RECONCILE_INTERVAL_S=30
RISK_CHECK_INTERVAL_S=5
TIME_SYNC_INTERVAL_S=1800
WS_STALE_TIMEOUT_S=90
MAX_PRICE_AGE_S=30
PAPER_INITIAL_BALANCE=1000
# User data stream via WebSocket API (listenToken). REST reconciliation tetap
# menjadi sumber kebenaran; aktifkan setelah diverifikasi di akun Anda.
USE_USER_STREAM=false
# Buat file ini (touch state/KILL) untuk menghentikan entry baru secara manual
KILL_FILE=state/KILL

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backtest ----------------------------------------------------------------
# Simpan di luar folder kode agar update kode tidak menghapusnya
BACKTEST_DATA_DIR=data/historical
BACKTEST_RESULTS_DIR=backtest/results
BACKTEST_INITIAL_EQUITY=1000
BACKTEST_START=
BACKTEST_END=
BACKTEST_OOS_SPLIT=0.7
