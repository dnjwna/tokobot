# ============================================================================
# TokoBot - example config. Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env
# ============================================================================

# --- Mode: BACKTEST | PAPER | LIVE -----------------------------------------
TRADING_MODE=PAPER
# LIVE mode refuses to start unless this is exactly I_UNDERSTAND_REAL_MONEY_RISK
LIVE_CONFIRM=

# --- Tokocrypto API credentials (a DEDICATED bot key: Trade ON, Withdraw OFF,
#     VPS IP whitelisted). Leave empty for BACKTEST/PAPER.
TOKO_API_KEY=
TOKO_API_SECRET=

# --- Endpoints (defaults follow the API docs; change only if Tokocrypto does)
TOKO_REST_BASE=https://www.tokocrypto.com
TOKO_MARKET_BASE_TYPE1=https://www.tokocrypto.site
TOKO_MARKET_BASE_TYPE3=https://cloudme-toko.2meta.app
TOKO_WS_MARKET_TYPE1=wss://stream-cloud.tokocrypto.site
TOKO_WS_MARKET_TYPE3=wss://stream-toko.2meta.app
TOKO_WS_API_URL=wss://ws-api.tokocrypto.site:443/ws-api/v3
TOKO_RECV_WINDOW_MS=5000
TOKO_REQUEST_TIMEOUT_S=10
# The docs give no numeric limit; this is conservative. The bot also reads the
# X-MBX-USED-WEIGHT-* headers and honours Retry-After (429/418).
TOKO_WEIGHT_LIMIT_PER_MIN=600
TOKO_MAX_RETRIES=5

# --- Market ------------------------------------------------------------------
SYMBOLS=BTC_USDT,ETH_USDT
QUOTE_ASSET=USDT
TIMEFRAME=4h
HISTORY_BARS=1000

# --- Costs (fractions, 0.001 = 0.1%) --------------------------------------------
# Check your account's real fee: python scripts/preflight.py --private
# (the VIP0 account verified in Nov 2026 pays 0.15%)
FEE_MAKER=0.0015
FEE_TAKER=0.0015
# 0.21% final income tax (PMK 50/2025, domestic exchange). Applied on both
# sides by default (conservative). Verify taxRate in your account's trade history.
TAX_RATE_BUY=0.0021
TAX_RATE_SELL=0.0021
SLIPPAGE_PCT=0.0005

# --- Strategy: Volatility Breakout + Regime Filter --------------------------
DONCHIAN_ENTRY=20
EMA_FAST=50
EMA_SLOW=200
EMA_SLOPE_LOOKBACK=10
ADX_PERIOD=14
ADX_MIN=22
ADX_STRONG=30
ADX_RISING_LOOKBACK=3
ATR_PERIOD=14
ATR_PCT_MIN=0.004
ATR_PCT_MAX=0.06
ER_PERIOD=20
ER_MIN=0.30
CLOSE_POSITION_MIN=0.60
VOLUME_SMA_PERIOD=20
VOLUME_MULT=1.0
SL_ATR_MULT=3.0
TP1_R_MULTIPLE=1.5
TP1_FRACTION=0.5
TRAIL_ATR_MULT=3.0
MIN_REWARD_COST_RATIO=3.0
# Round-trip cost divided by stop distance. 0.25 = costs at most 25% of 1R.
# Example: 0.82% costs -> stop at least 3.28% below entry.
MAX_COST_TO_RISK=0.25

# --- Risk & Kill-Switches -----------------------------------------------------
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=2
MAX_POSITION_PCT=0.30
DAILY_MAX_DRAWDOWN=0.03
MAX_TOTAL_DRAWDOWN=0.15
MAX_CONSECUTIVE_LOSSES=4
LOSS_STREAK_PAUSE_HOURS=24
KILL_SWITCH_FLATTEN=false
DAY_RESET_TZ=Asia/Jakarta
USE_EXCHANGE_STOP=true
STOP_LIMIT_BUFFER=0.005
TRAIL_MIN_STEP_PCT=0.002
MAX_ENTRY_SLIPPAGE=0.003
# >0 = the bot treats at most this many USDT as its equity (0 = whole balance)
CAPITAL_CAP_QUOTE=0

# --- Runtime -----------------------------------------------------------------
STATE_DIR=state
LOG_DIR=logs
LOG_LEVEL=INFO
RECONCILE_INTERVAL_S=30
RISK_CHECK_INTERVAL_S=5
TIME_SYNC_INTERVAL_S=1800
WS_STALE_TIMEOUT_S=90
MAX_PRICE_AGE_S=30
PAPER_INITIAL_BALANCE=1000
# User data stream via the WebSocket API (listenToken). REST reconciliation stays
# the source of truth; enable only after verifying it on your account.
USE_USER_STREAM=false
# Create this file (touch state/KILL) to stop new entries manually
KILL_FILE=state/KILL

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backtest ----------------------------------------------------------------
# Keep outside the code folder so code updates never delete it
BACKTEST_DATA_DIR=data/historical
BACKTEST_RESULTS_DIR=backtest/results
BACKTEST_INITIAL_EQUITY=1000
BACKTEST_START=
BACKTEST_END=
BACKTEST_OOS_SPLIT=0.7
