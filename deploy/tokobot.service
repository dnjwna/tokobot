# /etc/systemd/system/tokobot.service
[Unit]
Description=TokoBot - Tokocrypto spot trading bot
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=tokobot
Group=tokobot
WorkingDirectory=/opt/tokobot
EnvironmentFile=/opt/tokobot/.env
ExecStart=/opt/tokobot/.venv/bin/python /opt/tokobot/main.py
Restart=on-failure
RestartSec=15
# exit 2 = konfigurasi tidak valid -> jangan restart terus-menerus
RestartPreventExitStatus=2
StartLimitIntervalSec=600
StartLimitBurst=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tokobot/state /opt/tokobot/logs

[Install]
WantedBy=multi-user.target
